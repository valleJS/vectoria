# Copy to /opt/vectoria/vectoria.env on the server and fill in. Never commit the real file.
ADMIN_TOKEN=change-me-to-a-long-random-value
PUBLIC_URL=https://vectoria.example.com
ALLOWED_ORIGINS=https://vectoria.example.com

GAME_HOURS=weekdays
GAME_TIMEZONE=Europe/Berlin
TIME_SCALE=1
VICTORY_POINTS_TO_WIN=25
TICK_RATE=5

# Email login codes (required in production). Encrypted either way:
# port 465 → SMTP_SECURE=true (implicit TLS), port 587 → SMTP_SECURE=false (STARTTLS, enforced).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=vectoria@example.com
SMTP_PASS=secret
MAIL_FROM=Vectoria <vectoria@example.com>
