# Copy to .env. Every value is optional; the defaults below are used when unset.
PORT=3001
HOST=0.0.0.0
TICK_RATE=5
# MAP_SEED=12345

# Admin panel token (client: /?admin). Defaults to "admin" in development; required in production.
# ADMIN_TOKEN=change-me

# weekdays = game clock runs Mon–Fri 10–18 in GAME_TIMEZONE; always = clock never stops (dev).
GAME_HOURS=weekdays
GAME_TIMEZONE=Europe/Berlin
# Game-clock speed multiplier for testing (e.g. 60 → one gameday hour per real minute).
TIME_SCALE=1
VICTORY_POINTS_TO_WIN=25

# Email login (one-time codes). Without SMTP_HOST, codes are printed to the server log (dev only);
# SMTP_HOST is required in production. SMTP_SECURE=true for implicit TLS (port 465).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=vectoria@example.com
# SMTP_PASS=secret
# MAIL_FROM=Vectoria <vectoria@example.com>
# Base URL used for the login link in emails (defaults to the request's Origin).
# PUBLIC_URL=https://play.example.com

# Save file for the running game (JSON, rewritten every few seconds).
DATA_FILE=data/game.json

# Comma-separated list of allowed WebSocket origins. Empty = allow all (dev only).
# ALLOWED_ORIGINS=https://play.example.com

# Leave unset to run without Postgres/Redis. Start them with `npm run services:up`.
# DATABASE_URL=postgres://vectoria:vectoria@localhost:5432/vectoria
# REDIS_URL=redis://localhost:6379
